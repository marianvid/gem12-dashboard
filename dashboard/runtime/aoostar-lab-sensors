        echo "lab_nvidia_process_vram: $nvidia_process_vram"
        echo "lab_nvidia_dcgm: $nvidia_dcgm"
        echo "lab_nvidia_xid: $nvidia_xid"
        echo "lab_nvidia_ok: $nvidia_ok"
        echo "lab_nvidia_warning: $nvidia_warning"
        echo "lab_nvidia_critical: $nvidia_critical"
        echo "lab_memory_temp: $memory_temp"
        echo "lab_mem_percent: $mem_percent"
        echo "lab_swap_percent: $swap_percent"
        echo "lab_load_one: $load_one"
        echo "lab_health_compute_ok: ${compute_ok/ OK/}"
        echo "lab_health_compute_warning: $compute_warning"
        echo "lab_health_compute_critical: $compute_critical"
        if [ "$nvidia_present" -eq 1 ]; then
            echo "lab_health_compute_summary: CPU ${cpu_temp_now}° · GPU ${nvidia_temp}°"
        else
            echo "lab_health_compute_summary: CPU ${cpu_temp_now}°"
        fi
        echo "lab_health_storage_ok: ${storage_ok/ OK/}"
        echo "lab_health_storage_warning: $storage_warning"
        echo "lab_health_storage_critical: $storage_critical"
        echo "lab_health_storage_summary: $storage_detected DISKS · MAX ${storage_max_temp}°C"
        echo "lab_health_network_ok: ${network_ok/ OK/}"
        echo "lab_health_network_warning: $network_warning"
        echo "lab_health_network_critical: $network_critical"
        echo "lab_health_network_summary: ↓ $down_display · ↑ $up_display"
        echo "lab_health_services_ok: ${services_ok/ OK/}"
        echo "lab_health_services_warning: $services_warning"
        echo "lab_health_services_critical: $services_critical"
        echo "lab_health_services_summary: GUESTS $guest_running/$guest_total · CORE $core_service_active/$core_service_total"
        echo "lab_lexar_temp: $lexar_temp"
