        echo "lab_storage_counts: $storage_int_count INT · $storage_ext_count EXT"
        echo "lab_storage_layout: ${storage_int_count}${storage_ext_count}"
        echo "lab_storage_int1_present: $lexar_present"
        echo "lab_storage_int2_present: $lexar2_present"
        echo "lab_storage_int1_name: $lexar_name"
        echo "lab_storage_int1_temp: $lexar_temp_display"
        echo "lab_storage_int1_ok: $lexar_ok"
        echo "lab_storage_int1_warning: $lexar_warning"
        echo "lab_storage_int1_critical: $lexar_critical"
        echo "lab_storage_int2_name: $lexar2_name"
        echo "lab_storage_int2_temp: $lexar2_temp_display"
        echo "lab_storage_int2_ok: $lexar2_ok"
        echo "lab_storage_int2_warning: $lexar2_warning"
        echo "lab_storage_int2_critical: $lexar2_critical"
        echo "lab_storage_ext1_present: $corsair_present"
        echo "lab_storage_ext1_name: $display_ext1_name"
        echo "lab_storage_ext1_temp: $display_ext1_temp"
        echo "lab_storage_ext1_ok: $display_ext1_ok"
        echo "lab_storage_ext1_warning: $display_ext1_warning"
