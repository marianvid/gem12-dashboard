        echo "lab_corsair_cycles: $(smart_field "$corsair_cache" "Power Cycles")"
        echo "lab_corsair_capacity: $corsair_capacity"
        echo "lab_corsair_media_errors: $corsair_media_errors"
        echo "lab_corsair_error_entries: $(smart_field "$corsair_cache" "Error Information Log Entries")"
        echo "lab_corsair_warning_temp_time: $(smart_field "$corsair_cache" "Warning  Comp. Temperature Time")"
        echo "lab_corsair_read_commands: $(smart_field "$corsair_cache" "Host Read Commands")"
        echo "lab_corsair_write_commands: $(smart_field "$corsair_cache" "Host Write Commands")"
        echo "lab_corsair_busy_time: $(smart_field "$corsair_cache" "Controller Busy Time") min"
        echo "lab_vm_state: $vm_running/$vm_total"
