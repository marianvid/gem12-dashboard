        echo "lab_lexar_read: $lexar_read"
        echo "lab_lexar_written: $lexar_written"
        echo "lab_lexar_hours: $lexar_hours"
        echo "lab_lexar_critical: $lexar_critical_warning"
        echo "lab_lexar_spare: $(smart_field "$lexar_cache" "Available Spare")"
        echo "lab_lexar_spare_threshold: $(smart_field "$lexar_cache" "Available Spare Threshold")"
        echo "lab_lexar_cycles: $(smart_field "$lexar_cache" "Power Cycles")"
        echo "lab_lexar_capacity: $lexar_capacity"
        echo "lab_lexar_media_errors: $lexar_media_errors"
        echo "lab_lexar_error_entries: $(smart_field "$lexar_cache" "Error Information Log Entries")"
        echo "lab_lexar_warning_temp_time: $(smart_field "$lexar_cache" "Warning  Comp. Temperature Time")"
