#!/bin/bash
set -u

config_file=${HOME_LAB_CONFIG:-/etc/home-lab/devices.conf}
if [ -r "$config_file" ]; then
    # shellcheck source=/dev/null
    . "$config_file"
fi

internal_device=${HOME_LAB_INTERNAL_DEVICE:-}
external_device=${HOME_LAB_EXTERNAL_DEVICE:-}
external_mount=${HOME_LAB_EXTERNAL_MOUNT:-/mnt/pve/media4tb}

run_dir=/run/aoostar-display
out_file="$run_dir/lab.txt"
state_file="$run_dir/network.state"
pve_cache_file="$run_dir/pve-inventory.state"
smart_cache_dir=/run/aoostar-smart-cache
persistent_smart_cache_dir=/var/lib/aoostar-display/smart-cache
mkdir -p "$run_dir"
mkdir -p "$smart_cache_dir"
mkdir -p "$persistent_smart_cache_dir"

value_from_sysinfo() {
    awk -F': ' -v key="$1" '$1 == key {print $2; exit}' "$run_dir/sysinfo.txt" 2>/dev/null | sed 's/ °C$//'
}

compact_uptime() {
    awk '{s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60); if (d>0) printf "%dd %dh %dm",d,h,m; else printf "%dh %dm",h,m}' /proc/uptime
}

smart_health() {
    smartctl -H "$1" 2>/dev/null | awk -F: '/overall-health|Health Status/ {gsub(/^[ \t]+/,"",$2); print $2; exit}' | sed 's/PASSED/OK/'
}

refresh_smart_cache() {
    dev="$1"; cache="$2"; stamp="$3"
    cache_time=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if [ $((stamp-cache_time)) -ge 10 ] && [ -e "$dev" ]; then
        smart_tmp="$cache.$$.tmp"
        if smartctl -a "$dev" > "$smart_tmp" 2>/dev/null; then
            mv "$smart_tmp" "$cache"
        else
            rm -f "$smart_tmp"
        fi
    fi
}

refresh_smart_cache_when_active() {
    dev="$1"; cache="$2"; stamp="$3"
    real_dev=$(readlink -f "$dev" 2>/dev/null || true)
    block_name=${real_dev##*/}
    io_state="$smart_cache_dir/${block_name}.io"
    cache_time=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    smart_sleeping=0

    [ -n "$block_name" ] && [ -r "/sys/class/block/$block_name/stat" ] || return
    io_signature=$(awk '{print $1 ":" $3 ":" $5 ":" $7}' "/sys/class/block/$block_name/stat" 2>/dev/null)
    [ -n "$io_signature" ] || return

    last_activity=$stamp
    old_signature=""
    if [ -r "$io_state" ]; then
        read -r last_activity old_signature < "$io_state" || true
    fi

    if [ -z "$old_signature" ]; then
        printf '%s %s\n' "$stamp" "$io_signature" > "$io_state"
        return
    fi

    if [ "$io_signature" != "$old_signature" ]; then
        last_activity=$stamp
        printf '%s %s\n' "$last_activity" "$io_signature" > "$io_state"
    elif [ $((stamp-last_activity)) -ge 900 ]; then
        smart_sleeping=1
    fi

    # USB-to-SATA bridges may ignore smartctl's `-n standby` guard and wake a
    # rotating disk. Refresh SMART only after genuine block I/O proves that
    # the disk is already active; otherwise retain the last known snapshot.
    if [ "$io_signature" != "$old_signature" ] && [ $((stamp-cache_time)) -ge 60 ] && [ -e "$dev" ]; then
        smart_tmp="$cache.$$.tmp"
        if smartctl -a "$dev" > "$smart_tmp" 2>/dev/null || grep -qE '^(Device Model|Model Number):' "$smart_tmp"; then
            mv "$smart_tmp" "$cache"
        else
            rm -f "$smart_tmp"
        fi
    fi
}

smart_field() {
    awk -F: -v wanted="$2" '
        {key=$1; gsub(/^[ \t]+|[ \t]+$/, "", key)}
        key == wanted {sub(/^[^:]*:[ \t]*/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit}
    ' "$1" 2>/dev/null
}

smart_bracket_value() {
    smart_field "$1" "$2" | sed -n 's/.*\[\([^]]*\)\].*/\1/p'
}

without_percent() {
    printf '%s' "$1" | tr -d '%'
}

format_used_percent() {
    awk -v used="$1" -v total="$2" 'BEGIN {
        if (total <= 0) { print "N/A"; exit }
        pct = used * 100 / total
        if (used == 0) print "0.0%"
        else if (pct < 0.1) print "<0.1%"
        else printf "%.1f%%", pct
    }'
}

format_capacity_pair() {
    awk -v available="$1" -v capacity="$2" 'BEGIN {
        tib = 1099511627776
        if (capacity <= 0) { print "N/A"; exit }
        if (available < 0) printf "N/A / %.1f TiB", capacity/tib
        else printf "%.1f / %.1f TiB", available/tib, capacity/tib
    }'
}

format_network_rate() {
    awk -v bytes="$1" -v seconds="$2" 'BEGIN {
        if (seconds <= 0) { print "0 KB/s"; exit }
        bytes_per_second = bytes / seconds
        if (bytes_per_second < 1000000)
            printf "%.0f KB/s", bytes_per_second / 1000
        else
            printf "%.2f Mb/s", bytes_per_second * 8 / 1000000
    }'
}

collect_pve_inventory() {
    qm_snapshot=$(qm list 2>/dev/null || true)
    pct_snapshot=$(pct list 2>/dev/null || true)
    pvesm_snapshot=$(pvesm status 2>/dev/null || true)

    vm_total=$(printf '%s\n' "$qm_snapshot" | awk 'NR>1 {n++} END {print n+0}')
    vm_running=$(printf '%s\n' "$qm_snapshot" | awk 'NR>1 && $3=="running" {n++} END {print n+0}')
    ct_total=$(printf '%s\n' "$pct_snapshot" | awk 'NR>1 {n++} END {print n+0}')
    ct_running=$(printf '%s\n' "$pct_snapshot" | awk 'NR>1 && $2=="running" {n++} END {print n+0}')
    storage_total=$(printf '%s\n' "$pvesm_snapshot" | awk 'NR>1 {n++} END {print n+0}')
    storage_active=$(printf '%s\n' "$pvesm_snapshot" | awk 'NR>1 && $3=="active" {n++} END {print n+0}')
    guests=$( {
        printf '%s\n' "$qm_snapshot" | awk 'NR>1 && $3=="running" {print $1}'
        printf '%s\n' "$pct_snapshot" | awk 'NR>1 && $2=="running" {print $1}'
    } | paste -sd, -)
    [ -n "$guests" ] || guests=none

    pve_tmp="$pve_cache_file.$BASHPID.tmp"
    printf '%s|%s|%s|%s|%s|%s|%s\n' \
        "$vm_running" "$vm_total" "$ct_running" "$ct_total" \
        "$storage_active" "$storage_total" "$guests" > "$pve_tmp"
    mv "$pve_tmp" "$pve_cache_file"
}

storage_model_label() {
    device=$1
    cache=$2
    fallback=$3
    model=$(smart_field "$cache" "Model Number")
    [ -n "$model" ] || model=$(smart_field "$cache" "Device Model")
    [ -n "$model" ] || model=$(lsblk -dn -o MODEL "$device" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]][[:space:]]*/ /g')
    [ -n "$model" ] || model=$fallback
    printf '%.24s' "$model"
}

assign_health_tokens() {
    prefix=$1
    state=$2
    eval "${prefix}_ok='' ${prefix}_warning='' ${prefix}_critical=''"
    case "$state" in
        ok) eval "${prefix}_ok='✓ OK'" ;;
        warning) eval "${prefix}_warning='● Warn'" ;;
        critical)
            if [ $((now % 2)) -eq 0 ]; then
                eval "${prefix}_critical='● Err'"
            else
                eval "${prefix}_critical='  Err'"
            fi
            ;;
    esac
}

pve_refresh_pid=""
nvidia_xid=0
nvidia_xid_checked=0
cached_nvidia_cuda=N/A
nvidia_cuda_checked=0

# Populate event-like Proxmox state once before the fast metrics loop. Later
# refreshes run in the background so a slow `qm`, `pct` or `pvesm` call cannot
# stall CPU, memory and network updates.
collect_pve_inventory

while true; do
    now=$(date +%s)
    iface=$(ip route show default 2>/dev/null | awk 'NR==1 {print $5}')
    [ -n "$iface" ] || iface=vmbr0
    rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)
    tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)
    down=0; up=0; rx_delta=0; tx_delta=0; dt=0
    if [ -r "$state_file" ]; then
        read -r old_now old_rx old_tx < "$state_file" || true
        dt=$((now-old_now))
        if [ "$dt" -gt 0 ] && [ "$rx" -ge "$old_rx" ] && [ "$tx" -ge "$old_tx" ]; then
            rx_delta=$((rx-old_rx)); tx_delta=$((tx-old_tx))
            down=$(awk -v n="$rx_delta" -v d="$dt" 'BEGIN {printf "%.2f", n*8/d/1000000}')
            up=$(awk -v n="$tx_delta" -v d="$dt" 'BEGIN {printf "%.2f", n*8/d/1000000}')
        fi
    fi
    down_display=$(format_network_rate "$rx_delta" "$dt")
    up_display=$(format_network_rate "$tx_delta" "$dt")
    printf '%s %s %s\n' "$now" "$rx" "$tx" > "$state_file"

    read -r _ u1 n1 s1 i1 w1 irq1 si1 st1 _ < /proc/stat
    total1=$((u1+n1+s1+i1+w1+irq1+si1+st1)); idle1=$((i1+w1))
    sleep 1
    read -r _ u2 n2 s2 i2 w2 irq2 si2 st2 _ < /proc/stat
    total2=$((u2+n2+s2+i2+w2+irq2+si2+st2)); idle2=$((i2+w2))
    delta=$((total2-total1)); idle_delta=$((idle2-idle1))
    if [ "$delta" -gt 0 ]; then
        cpu=$(awk -v busy="$((delta-idle_delta))" -v total="$delta" 'BEGIN {printf "%.1f", 100*busy/total}')
    else
        cpu=0.0
    fi

    if [ -n "$pve_refresh_pid" ] && ! kill -0 "$pve_refresh_pid" 2>/dev/null; then
        wait "$pve_refresh_pid" 2>/dev/null || true
        pve_refresh_pid=""
    fi
    pve_cache_time=$(stat -c %Y "$pve_cache_file" 2>/dev/null || echo 0)
    if [ -z "$pve_refresh_pid" ] && [ $((now-pve_cache_time)) -ge 5 ]; then
        collect_pve_inventory &
        pve_refresh_pid=$!
    fi
    IFS='|' read -r vm_running vm_total ct_running ct_total storage_active storage_total guests < "$pve_cache_file" || true
    storage_detected=$(lsblk -dn -o TYPE 2>/dev/null | awk '$1=="disk" {n++} END {print n+0}')
    power_transition_status=$(cat "$run_dir/power-transition-status" 2>/dev/null || true)
    startup_status=$(cat "$run_dir/startup-status" 2>/dev/null || true)

    ip_addr=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')
    [ -n "$ip_addr" ] || ip_addr="no address"
    speed=$(cat "/sys/class/net/$iface/speed" 2>/dev/null || echo unknown)
    [ "$speed" != "-1" ] || speed=unknown
    total_traffic=$(numfmt --to=iec --suffix=B $((rx+tx)) 2>/dev/null || echo "$((rx+tx)) B")
    rx_total=$(numfmt --to=iec --suffix=B "$rx" 2>/dev/null || echo "$rx B")
    tx_total=$(numfmt --to=iec --suffix=B "$tx" 2>/dev/null || echo "$tx B")
    gateway=$(ip route show default 2>/dev/null | awk 'NR==1 {print $3}')
    [ -n "$gateway" ] || gateway="N/A"
    carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo 0)

    cpu_freq=$(awk '{sum+=$1; n++} END {if(n) printf "%.2f", sum/n/1000000; else print "N/A"}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null)
    gpu_temp=$(value_from_sysinfo temperature_gpu); gpu_temp=${gpu_temp:-N/A}
    memory_temp=$(value_from_sysinfo temperature_memory); memory_temp=${memory_temp:-N/A}
    mem_percent=$(awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {if(t) printf "%.1f", (t-a)*100/t; else print "0.0"}' /proc/meminfo)
    swap_percent=$(awk '/SwapTotal:/ {t=$2} /SwapFree:/ {f=$2} END {if(t) printf "%.1f", (t-f)*100/t; else print 0}' /proc/meminfo)
    load_one=$(awk '{print $1}' /proc/loadavg)

    nvidia_present=0
    nvidia_name=""; nvidia_temp="N/A"; nvidia_util="N/A"; nvidia_vram="N/A"
    nvidia_power="N/A"; nvidia_fan="N/A"; nvidia_driver="N/A"; nvidia_cuda="$cached_nvidia_cuda"
    nvidia_pstate="N/A"; nvidia_clock="N/A"; nvidia_mem_clock="N/A"
    nvidia_persistence="N/A"; nvidia_ecc="N/A"; nvidia_uuid="N/A"
    nvidia_pci="N/A"; nvidia_process="IDLE"; nvidia_process_vram="0 MiB"
    nvidia_dcgm="N/A"; nvidia_health=ok
    nvidia_snapshot=""
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia_snapshot=$(nvidia-smi \
            --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,power.limit,fan.speed,driver_version,pstate,clocks.current.graphics,clocks.current.memory,persistence_mode,ecc.mode.current,uuid,pci.bus_id,ecc.errors.corrected.aggregate.total,ecc.errors.uncorrected.aggregate.total \
            --format=csv,noheader,nounits 2>/dev/null | head -n1)
    fi
    if [ -n "$nvidia_snapshot" ]; then
        nvidia_present=1
        mapfile -t nvidia_fields < <(printf '%s\n' "$nvidia_snapshot" | awk -F, '{for (i=1; i<=NF; i++) {gsub(/^[ \t]+|[ \t]+$/, "", $i); print $i}}')
        nvidia_name=${nvidia_fields[0]:-NVIDIA GPU}
        nvidia_temp=${nvidia_fields[1]:-N/A}
        nvidia_util=${nvidia_fields[2]:-N/A}
        nvidia_memory_used=${nvidia_fields[3]:-N/A}; nvidia_memory_total=${nvidia_fields[4]:-N/A}
        nvidia_vram="${nvidia_memory_used:-N/A} / ${nvidia_memory_total:-N/A}"
        nvidia_power_draw=${nvidia_fields[5]:-N/A}; nvidia_power_limit=${nvidia_fields[6]:-N/A}
        if [[ "$nvidia_power_draw" =~ ^[0-9.]+$ ]] && [[ "$nvidia_power_limit" =~ ^[0-9.]+$ ]]; then
            nvidia_power=$(awk -v draw="$nvidia_power_draw" -v limit="$nvidia_power_limit" \
                'BEGIN {printf "%.2f / %.0f", draw, limit}')
        fi
        nvidia_fan=${nvidia_fields[7]:-N/A}
        nvidia_driver=${nvidia_fields[8]:-N/A}
        if [ $((now-nvidia_cuda_checked)) -ge 60 ]; then
            cached_nvidia_cuda=$(nvidia-smi 2>/dev/null | sed -n 's/.*CUDA UMD Version: \([0-9.]*\).*/\1/p' | head -n1)
            cached_nvidia_cuda=${cached_nvidia_cuda:-N/A}
            nvidia_cuda_checked=$now
        fi
        nvidia_cuda=$cached_nvidia_cuda
        nvidia_pstate=${nvidia_fields[9]:-N/A}
        nvidia_clock=${nvidia_fields[10]:-N/A}
        nvidia_mem_clock=${nvidia_fields[11]:-N/A}
        nvidia_persistence=${nvidia_fields[12]:-N/A}
        nvidia_ecc=${nvidia_fields[13]:-N/A}
        nvidia_uuid=${nvidia_fields[14]:-N/A}
        nvidia_pci=${nvidia_fields[15]:-N/A}
        nvidia_ecc_errors="${nvidia_fields[16]:-N/A} / ${nvidia_fields[17]:-N/A}"
        nvidia_process_line=$(nvidia-smi --query-compute-apps=process_name,used_memory --format=csv,noheader,nounits 2>/dev/null | head -n1)
        if [ -n "$nvidia_process_line" ]; then
            nvidia_process=$(printf '%s' "$nvidia_process_line" | cut -d, -f1 | sed 's/^[[:space:]]*//; s#.*/##' | cut -c1-22)
            nvidia_process_vram="$(printf '%s' "$nvidia_process_line" | cut -d, -f2 | tr -d ' ') MiB"
        fi
        systemctl is-active --quiet nvidia-dcgm.service && nvidia_dcgm=OK || nvidia_dcgm=DOWN
        if [ $((now-nvidia_xid_checked)) -ge 60 ]; then
            nvidia_xid=$(journalctl -k -b --no-pager 2>/dev/null | grep -c 'NVRM: Xid' || true)
            nvidia_xid_checked=$now
        fi
        [ "$nvidia_dcgm" = OK ] || nvidia_health=critical
        [ "$nvidia_xid" -eq 0 ] || nvidia_health=critical
        [ "${nvidia_temp%.*}" -ge 88 ] 2>/dev/null && nvidia_health=critical
        [ "${nvidia_temp%.*}" -ge 80 ] 2>/dev/null && [ "$nvidia_health" = ok ] && nvidia_health=warning
    fi
    # `temperature_gpu` is the integrated GPU on this host. The generic
    # Compute panel should report the primary accelerator when NVIDIA exists.
    [ "$nvidia_present" -eq 1 ] && gpu_temp=$nvidia_temp

    pve_services="pveproxy pvedaemon pvestatd pve-cluster"
    lab_services="aoostar-display aoostar-sysinfo aoostar-lab-sensors mafp-next-panel aoostar-power-button aoostar-health-monitor"
    pve_service_total=0; pve_service_active=0
    for service in $pve_services; do
        pve_service_total=$((pve_service_total+1))
        systemctl is-active --quiet "$service" && pve_service_active=$((pve_service_active+1))
    done
    lab_service_total=0; lab_service_active=0
    for service in $lab_services; do
        lab_service_total=$((lab_service_total+1))
        systemctl is-active --quiet "$service" && lab_service_active=$((lab_service_active+1))
    done
    failed_units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk 'NF {n++} END {print n+0}')
    ssh_state=$(systemctl is-active ssh 2>/dev/null || true); [ "$ssh_state" = active ] && ssh_state=RUNNING || ssh_state=DOWN

    corsair_temp=$(value_from_sysinfo temperature_nvme_Composite_Corsair_EX400U); corsair_temp=${corsair_temp:-0}
    lexar_dev=$internal_device
    lexar_real=$(readlink -f "$lexar_dev" 2>/dev/null || true)
    corsair_dev=$external_device
    corsair_real=$(readlink -f "$corsair_dev" 2>/dev/null || true)
    lexar2_dev=$(lsblk -dpno PATH,TYPE,TRAN 2>/dev/null | awk -v primary="$lexar_real" -v external="$corsair_real" '$2=="disk" && $3=="nvme" && $1!=primary && $1!=external {print $1; exit}')
    ext2_dev=$(lsblk -dpno PATH,TYPE,TRAN 2>/dev/null | awk -v known="$corsair_dev" '$2=="disk" && $3=="usb" && $1!=known {print $1; exit}')
    lexar_total_bytes=$(blockdev --getsize64 "$lexar_dev" 2>/dev/null || echo 0)
    lexar_root_used=$(df -B1 --output=used / 2>/dev/null | awk 'NR==2 {print $1+0}')
    lexar_efi_used=$(df -B1 --output=used /boot/efi 2>/dev/null | awk 'NR==2 {print $1+0}')
    lexar_thin_used=$(lvs --noheadings --units b --nosuffix -o lv_size,data_percent pve/data 2>/dev/null | awk '{printf "%.0f", $1*$2/100}')
    lexar_used_bytes=$((${lexar_root_used:-0}+${lexar_efi_used:-0}+${lexar_thin_used:-0}))
    lexar_used=$(format_used_percent "$lexar_used_bytes" "$lexar_total_bytes")
    lexar_available_bytes=$((lexar_total_bytes-lexar_used_bytes))
    lexar_capacity=$(format_capacity_pair "$lexar_available_bytes" "$lexar_total_bytes")
    lexar2_total_bytes=$(blockdev --getsize64 "$lexar2_dev" 2>/dev/null || echo 0)
    lexar2_mount=$(lsblk -nrpo MOUNTPOINT "$lexar2_dev" 2>/dev/null | awk 'NF {print; exit}')
    read -r lexar2_used_bytes lexar2_available_bytes lexar2_capacity_bytes <<EOF
$(df -B1 --output=used,avail,size "$lexar2_mount" 2>/dev/null | awk 'NR==2 {print $1+0, $2+0, $3+0}')
EOF
    lexar2_capacity=$(format_capacity_pair "${lexar2_available_bytes:--1}" "${lexar2_capacity_bytes:-$lexar2_total_bytes}")
    if [ -n "$lexar2_mount" ] && [ -n "${lexar2_available_bytes:-}" ]; then
        lexar2_used=$(format_used_percent "$lexar2_used_bytes" "$lexar2_capacity_bytes")
    else
        lexar2_used="N/A"
    fi
    corsair_total_bytes=$(blockdev --getsize64 "$corsair_dev" 2>/dev/null || echo 0)
    corsair_used_bytes=$(df -B1 --output=used "$external_mount" 2>/dev/null | awk 'NR==2 {print $1+0}')
    corsair_used=$(format_used_percent "${corsair_used_bytes:-0}" "$corsair_total_bytes")
    read -r corsair_available_bytes corsair_capacity_bytes <<EOF
$(df -B1 --output=avail,size "$external_mount" 2>/dev/null | awk 'NR==2 {print $1+0, $2+0}')
EOF
    corsair_capacity=$(format_capacity_pair "${corsair_available_bytes:-0}" "${corsair_capacity_bytes:-0}")
    lexar_cache="$smart_cache_dir/lexar-smart.txt"
    lexar2_cache="$smart_cache_dir/lexar2-smart.txt"
    corsair_cache="$smart_cache_dir/corsair-smart.txt"
    ext2_cache="$persistent_smart_cache_dir/ext2-smart.txt"
    refresh_smart_cache "$lexar_dev" "$lexar_cache" "$now"
    if [ -n "$lexar2_dev" ]; then
        lexar2_identity=$(lsblk -dn -o MODEL,SERIAL "$lexar2_dev" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]][[:space:]]*/ /g; s/[[:space:]]*$//')
        lexar2_identity_file="$smart_cache_dir/lexar2.identity"
        old_lexar2_identity=$(cat "$lexar2_identity_file" 2>/dev/null || true)
        if [ "$lexar2_identity" != "$old_lexar2_identity" ]; then
            rm -f "$lexar2_cache"
            printf '%s\n' "$lexar2_identity" > "$lexar2_identity_file"
        fi
        refresh_smart_cache "$lexar2_dev" "$lexar2_cache" "$now"
    else
        rm -f "$lexar2_cache" "$smart_cache_dir/lexar2.identity"
    fi
    refresh_smart_cache "$corsair_dev" "$corsair_cache" "$now"
    ext2_sleeping=0
    if [ -n "$ext2_dev" ]; then
        ext2_identity=$(lsblk -dn -o MODEL,SERIAL "$ext2_dev" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]][[:space:]]*/ /g; s/[[:space:]]*$//')
        ext2_identity_file="$persistent_smart_cache_dir/ext2.identity"
        old_ext2_identity=$(cat "$ext2_identity_file" 2>/dev/null || true)
        if [ "$ext2_identity" != "$old_ext2_identity" ]; then
            rm -f "$ext2_cache"
            ext2_block=$(basename "$(readlink -f "$ext2_dev" 2>/dev/null)")
            rm -f "$smart_cache_dir/${ext2_block}.io"
            printf '%s\n' "$ext2_identity" > "$ext2_identity_file"
        fi
        refresh_smart_cache_when_active "$ext2_dev" "$ext2_cache" "$now"
        ext2_sleeping=$smart_sleeping
    else
        # Keep the last snapshot while the removable disk is disconnected.
        # Its identity is validated before the cache is reused after insertion.
        :
    fi

    lexar_smart=$(smart_field "$lexar_cache" "SMART overall-health self-assessment test result"); lexar_smart=${lexar_smart/PASSED/OK}; lexar_smart=${lexar_smart:-N/A}
    lexar_temp=$(smart_field "$lexar_cache" "Temperature"); lexar_temp=${lexar_temp%% *}; lexar_temp=${lexar_temp:-N/A}
    lexar2_smart=$(smart_field "$lexar2_cache" "SMART overall-health self-assessment test result"); lexar2_smart=${lexar2_smart/PASSED/OK}; lexar2_smart=${lexar2_smart:-N/A}
    lexar2_temp=$(smart_field "$lexar2_cache" "Temperature"); lexar2_temp=${lexar2_temp%% *}; lexar2_temp=${lexar2_temp:-N/A}
    corsair_smart=$(smart_field "$corsair_cache" "SMART overall-health self-assessment test result"); corsair_smart=${corsair_smart/PASSED/OK}; corsair_smart=${corsair_smart:-N/A}
    lexar_wear=$(without_percent "$(smart_field "$lexar_cache" "Percentage Used")"); lexar_wear=${lexar_wear:-N/A}
    lexar2_wear=$(without_percent "$(smart_field "$lexar2_cache" "Percentage Used")"); lexar2_wear=${lexar2_wear:-N/A}
    corsair_wear=$(without_percent "$(smart_field "$corsair_cache" "Percentage Used")"); corsair_wear=${corsair_wear:-N/A}
    lexar_fw=$(smart_field "$lexar_cache" "Firmware Version"); lexar_fw=${lexar_fw:-N/A}
    corsair_fw=$(smart_field "$corsair_cache" "Firmware Version"); corsair_fw=${corsair_fw:-N/A}
    lexar_read=$(smart_bracket_value "$lexar_cache" "Data Units Read"); lexar_read=${lexar_read:-N/A}
    corsair_read=$(smart_bracket_value "$corsair_cache" "Data Units Read"); corsair_read=${corsair_read:-N/A}
    lexar_written=$(smart_bracket_value "$lexar_cache" "Data Units Written"); lexar_written=${lexar_written:-N/A}
    lexar2_written=$(smart_bracket_value "$lexar2_cache" "Data Units Written"); lexar2_written=${lexar2_written:-N/A}
    corsair_written=$(smart_bracket_value "$corsair_cache" "Data Units Written"); corsair_written=${corsair_written:-N/A}
    lexar_hours=$(smart_field "$lexar_cache" "Power On Hours"); lexar_hours=${lexar_hours:-N/A}
    lexar2_hours=$(smart_field "$lexar2_cache" "Power On Hours"); lexar2_hours=${lexar2_hours:-N/A}
    corsair_hours=$(smart_field "$corsair_cache" "Power On Hours"); corsair_hours=${corsair_hours:-N/A}
    lexar_critical_warning=$(smart_field "$lexar_cache" "Critical Warning"); lexar_critical_warning=${lexar_critical_warning:-N/A}
    lexar2_critical_warning=$(smart_field "$lexar2_cache" "Critical Warning"); lexar2_critical_warning=${lexar2_critical_warning:-N/A}
    corsair_critical_warning=$(smart_field "$corsair_cache" "Critical Warning"); corsair_critical_warning=${corsair_critical_warning:-N/A}
    lexar_media_errors=$(smart_field "$lexar_cache" "Media and Data Integrity Errors"); lexar_media_errors=${lexar_media_errors:-N/A}
    lexar2_media_errors=$(smart_field "$lexar2_cache" "Media and Data Integrity Errors"); lexar2_media_errors=${lexar2_media_errors:-N/A}
    corsair_media_errors=$(smart_field "$corsair_cache" "Media and Data Integrity Errors"); corsair_media_errors=${corsair_media_errors:-N/A}
    lexar_unsafe=$(smart_field "$lexar_cache" "Unsafe Shutdowns"); lexar_unsafe=${lexar_unsafe:-N/A}
    corsair_unsafe=$(smart_field "$corsair_cache" "Unsafe Shutdowns"); corsair_unsafe=${corsair_unsafe:-N/A}
    ext2_smart=$(smart_field "$ext2_cache" "SMART overall-health self-assessment test result"); ext2_smart=${ext2_smart/PASSED/OK}; ext2_smart=${ext2_smart:-N/A}
    ext2_temp=$(smart_field "$ext2_cache" "Temperature_Celsius")
    [ -n "$ext2_temp" ] || ext2_temp=$(awk '$2=="Temperature_Celsius" || $2=="Airflow_Temperature_Cel" {print $10; exit}' "$ext2_cache" 2>/dev/null)
    ext2_temp=${ext2_temp:-N/A}
    ext2_fw=$(smart_field "$ext2_cache" "Firmware Version"); ext2_fw=${ext2_fw:-N/A}
    ext2_hours=$(awk '$2=="Power_On_Hours" {print $10; exit}' "$ext2_cache" 2>/dev/null); ext2_hours=${ext2_hours:-N/A}
    ext2_reallocated=$(awk '$2=="Reallocated_Sector_Ct" {print $10; exit}' "$ext2_cache" 2>/dev/null); ext2_reallocated=${ext2_reallocated:-N/A}
    ext2_pending=$(awk '$2=="Current_Pending_Sector" {print $10; exit}' "$ext2_cache" 2>/dev/null); ext2_pending=${ext2_pending:-N/A}
    ext2_uncorrectable=$(awk '$2=="Offline_Uncorrectable" {print $10; exit}' "$ext2_cache" 2>/dev/null); ext2_uncorrectable=${ext2_uncorrectable:-N/A}
    ext2_media_errors="$ext2_reallocated/$ext2_pending/$ext2_uncorrectable"
    lexar_present=0; [ -n "$lexar_dev" ] && [ -e "$lexar_dev" ] && lexar_present=1
    lexar2_present=0; [ -n "$lexar2_dev" ] && [ -e "$lexar2_dev" ] && lexar2_present=1
    corsair_present=0; [ -n "$corsair_dev" ] && [ -e "$corsair_dev" ] && corsair_present=1
    ext2_present=0; [ -n "$ext2_dev" ] && [ -e "$ext2_dev" ] && ext2_present=1
    storage_int_count=$((lexar_present+lexar2_present))
    storage_ext_count=$((corsair_present+ext2_present))

    lexar_health=ok
    lexar2_health=ok
    corsair_health=ok
    ext2_health=ok
    if [ "$lexar_present" -eq 1 ]; then
        if [ "$lexar_smart" = "N/A" ]; then lexar_health=warning; elif [ "$lexar_smart" != "OK" ]; then lexar_health=critical; fi
        [ "$lexar_critical_warning" = "0x00" ] || [ "$lexar_critical_warning" = "0" ] || lexar_health=critical
        [ "$lexar_media_errors" = "N/A" ] || [ "${lexar_media_errors//,/}" -eq 0 ] 2>/dev/null || lexar_health=critical
        [ "${lexar_temp%.*}" -ge 80 ] 2>/dev/null && lexar_health=critical
        [ "${lexar_temp%.*}" -ge 70 ] 2>/dev/null && [ "$lexar_health" = ok ] && lexar_health=warning
        if [ "$lexar_wear" = "N/A" ]; then [ "$lexar_health" = ok ] && lexar_health=warning; else [ "${lexar_wear%.*}" -ge 90 ] 2>/dev/null && [ "$lexar_health" = ok ] && lexar_health=warning; fi
    fi
    if [ "$lexar2_present" -eq 1 ]; then
        if [ "$lexar2_smart" = "N/A" ]; then lexar2_health=warning; elif [ "$lexar2_smart" != "OK" ]; then lexar2_health=critical; fi
        [ "$lexar2_critical_warning" = "0x00" ] || [ "$lexar2_critical_warning" = "0" ] || lexar2_health=critical
        [ "$lexar2_media_errors" = "N/A" ] || [ "${lexar2_media_errors//,/}" -eq 0 ] 2>/dev/null || lexar2_health=critical
        [ "${lexar2_temp%.*}" -ge 80 ] 2>/dev/null && lexar2_health=critical
        [ "${lexar2_temp%.*}" -ge 70 ] 2>/dev/null && [ "$lexar2_health" = ok ] && lexar2_health=warning
        if [ "$lexar2_wear" = "N/A" ]; then [ "$lexar2_health" = ok ] && lexar2_health=warning; else [ "${lexar2_wear%.*}" -ge 90 ] 2>/dev/null && [ "$lexar2_health" = ok ] && lexar2_health=warning; fi
    fi
    if [ "$ext2_present" -eq 1 ] && [ "$ext2_sleeping" -eq 0 ]; then
        if [ "$ext2_smart" = "N/A" ]; then ext2_health=warning; elif [ "$ext2_smart" != "OK" ]; then ext2_health=critical; fi
        [ "$ext2_reallocated" = "N/A" ] || [ "$ext2_reallocated" -eq 0 ] 2>/dev/null || ext2_health=critical
        [ "$ext2_pending" = "N/A" ] || [ "$ext2_pending" -eq 0 ] 2>/dev/null || ext2_health=critical
        [ "$ext2_uncorrectable" = "N/A" ] || [ "$ext2_uncorrectable" -eq 0 ] 2>/dev/null || ext2_health=critical
        [ "${ext2_temp%.*}" -ge 60 ] 2>/dev/null && ext2_health=critical
        [ "${ext2_temp%.*}" -ge 50 ] 2>/dev/null && [ "$ext2_health" = ok ] && ext2_health=warning
    fi
    if [ "$corsair_present" -eq 1 ]; then
        if [ "$corsair_smart" = "N/A" ]; then corsair_health=warning; elif [ "$corsair_smart" != "OK" ]; then corsair_health=critical; fi
        [ "$corsair_critical_warning" = "0x00" ] || [ "$corsair_critical_warning" = "0" ] || corsair_health=critical
        [ "$corsair_media_errors" = "N/A" ] || [ "${corsair_media_errors//,/}" -eq 0 ] 2>/dev/null || corsair_health=critical
        [ "${corsair_temp%.*}" -ge 80 ] 2>/dev/null && corsair_health=critical
        [ "${corsair_temp%.*}" -ge 70 ] 2>/dev/null && [ "$corsair_health" = ok ] && corsair_health=warning
        if [ "$corsair_wear" = "N/A" ]; then [ "$corsair_health" = ok ] && corsair_health=warning; else [ "${corsair_wear%.*}" -ge 90 ] 2>/dev/null && [ "$corsair_health" = ok ] && corsair_health=warning; fi
    fi

    compute_health=ok
    cpu_temp_now=$(value_from_sysinfo temperature_cpu); cpu_temp_now=${cpu_temp_now:-N/A}
    if [ "$cpu_temp_now" = "N/A" ]; then
        compute_health=warning
    else
        [ "${cpu_temp_now%.*}" -ge 90 ] 2>/dev/null && compute_health=critical
        [ "${cpu_temp_now%.*}" -ge 80 ] 2>/dev/null && [ "$compute_health" = ok ] && compute_health=warning
    fi
    mem_percent_whole=${mem_percent%.*}
    [ "$mem_percent_whole" -ge 95 ] 2>/dev/null && compute_health=critical
    [ "$mem_percent_whole" -ge 85 ] 2>/dev/null && [ "$compute_health" = ok ] && compute_health=warning
    [ "$nvidia_present" -eq 1 ] && [ "$nvidia_health" = warning ] && [ "$compute_health" = ok ] && compute_health=warning
    [ "$nvidia_present" -eq 1 ] && [ "$nvidia_health" = critical ] && compute_health=critical

    storage_health=ok
    [ "$lexar_present" -eq 1 ] && [ "$lexar_health" = warning ] && storage_health=warning
    [ "$lexar2_present" -eq 1 ] && [ "$lexar2_health" = warning ] && storage_health=warning
    [ "$corsair_present" -eq 1 ] && [ "$corsair_health" = warning ] && storage_health=warning
    [ "$lexar_present" -eq 1 ] && [ "$lexar_health" = critical ] && storage_health=critical
    [ "$lexar2_present" -eq 1 ] && [ "$lexar2_health" = critical ] && storage_health=critical
    [ "$corsair_present" -eq 1 ] && [ "$corsair_health" = critical ] && storage_health=critical
    [ "$ext2_present" -eq 1 ] && [ "$ext2_health" = warning ] && storage_health=warning
    [ "$ext2_present" -eq 1 ] && [ "$ext2_health" = critical ] && storage_health=critical
    storage_max_temp=$(printf '%s\n%s\n%s\n%s\n' "$lexar_temp" "$lexar2_temp" "$corsair_temp" "$ext2_temp" | awk '$1 ~ /^[0-9.]+$/ && $1+0>m {m=$1+0} END {printf "%.0f",m}')

    network_health=ok
    [ "$carrier" = "1" ] || network_health=critical
    [ "$ip_addr" != "no address" ] || network_health=critical
    [ "$speed" != unknown ] || [ "$network_health" = critical ] || network_health=warning

    services_health=ok
    [ "$pve_service_active" -eq "$pve_service_total" ] || services_health=critical
    [ "$lab_service_active" -eq "$lab_service_total" ] || services_health=critical
    [ "$failed_units" -eq 0 ] || [ "$services_health" = critical ] || services_health=warning
    guest_running=$((vm_running+ct_running))
    guest_total=$((vm_total+ct_total))
    core_service_active=$((pve_service_active+lab_service_active))
    core_service_total=$((pve_service_total+lab_service_total))

    assign_health_tokens compute "$compute_health"
    assign_health_tokens storage "$storage_health"
    assign_health_tokens network "$network_health"
    assign_health_tokens services "$services_health"
    assign_health_tokens nvidia "$nvidia_health"

    lexar_name=""; lexar_temp_display=""; lexar_ok=""; lexar_warning=""; lexar_critical=""
    lexar2_name=""; lexar2_temp_display=""; lexar2_ok=""; lexar2_warning=""; lexar2_critical=""
    corsair_name=""; corsair_temp_display=""; corsair_ok=""; corsair_warning=""; corsair_critical=""
    ext2_name=""; ext2_temp_display=""; ext2_ok=""; ext2_warning=""; ext2_critical=""
    if [ "$lexar_present" -eq 1 ]; then
        lexar_name="INT 1 · $(storage_model_label "$lexar_dev" "$lexar_cache" "NVME")"
        lexar_temp_display="$lexar_temp"
        case "$lexar_health" in
            ok) lexar_ok="✓" ;;
            warning) lexar_warning="!" ;;
            critical) [ $((now % 2)) -eq 0 ] && lexar_critical="●" || lexar_critical="" ;;
        esac
    fi
    if [ "$lexar2_present" -eq 1 ]; then
        lexar2_name="INT 2 · $(storage_model_label "$lexar2_dev" "$lexar2_cache" "NVME")"
        lexar2_temp_display="$lexar2_temp"
        case "$lexar2_health" in
            ok) lexar2_ok="✓" ;;
            warning) lexar2_warning="!" ;;
            critical) [ $((now % 2)) -eq 0 ] && lexar2_critical="●" || lexar2_critical="" ;;
        esac
    fi
    if [ "$ext2_present" -eq 1 ]; then
        ext2_name="EXT 2 · $(storage_model_label "$ext2_dev" "$ext2_cache" "USB SATA")"
        if [ "$ext2_sleeping" -eq 1 ]; then ext2_temp_display="SLEEP"; else ext2_temp_display="$ext2_temp"; fi
        case "$ext2_health" in
            ok) ext2_ok="✓" ;;
            warning) ext2_warning="!" ;;
            critical) [ $((now % 2)) -eq 0 ] && ext2_critical="●" || ext2_critical="" ;;
        esac
    fi
    ext2_total_bytes=$(blockdev --getsize64 "$ext2_dev" 2>/dev/null || echo 0)
    ext2_mount=$(lsblk -nrpo MOUNTPOINT "$ext2_dev" 2>/dev/null | awk 'NF {print; exit}')
    read -r ext2_available_bytes ext2_capacity_bytes <<EOF
$(df -B1 --output=avail,size "$ext2_mount" 2>/dev/null | awk 'NR==2 {print $1+0, $2+0}')
EOF
    ext2_capacity=$(format_capacity_pair "${ext2_available_bytes:--1}" "${ext2_capacity_bytes:-$ext2_total_bytes}")
    if [ -n "$ext2_mount" ] && [ -n "${ext2_available_bytes:-}" ]; then
        ext2_used=$(format_used_percent "$((ext2_total_bytes-ext2_available_bytes))" "$ext2_total_bytes")
    else
        ext2_used="N/A"
    fi
    if [ "$corsair_present" -eq 1 ]; then
        corsair_name="EXT 1 · $(storage_model_label "$corsair_dev" "$corsair_cache" "USB4 NVME")"
        corsair_temp_display="$corsair_temp"
        case "$corsair_health" in
            ok) corsair_ok="✓" ;;
            warning) corsair_warning="!" ;;
            critical) [ $((now % 2)) -eq 0 ] && corsair_critical="●" || corsair_critical="" ;;
        esac
    fi
    if [ -e /sys/bus/thunderbolt/devices/1-2/authorized ] || [ -e /sys/bus/thunderbolt/devices/0-2/authorized ]; then corsair_link="USB4 NVME"; else corsair_link="CHECK"; fi

    # Compact external devices into display slots. This keeps one-device layouts
    # correct even when the permanently attached Corsair is temporarily absent.
    display_ext1_name=""; display_ext1_temp=""; display_ext1_ok=""; display_ext1_warning=""; display_ext1_critical=""
    display_ext2_name=""; display_ext2_temp=""; display_ext2_ok=""; display_ext2_warning=""; display_ext2_critical=""
    if [ "$corsair_present" -eq 1 ]; then
        display_ext1_name="$corsair_name"; display_ext1_temp="$corsair_temp_display"
        display_ext1_ok="$corsair_ok"; display_ext1_warning="$corsair_warning"; display_ext1_critical="$corsair_critical"
        if [ "$ext2_present" -eq 1 ]; then
            display_ext2_name="$ext2_name"; display_ext2_temp="$ext2_temp_display"
            display_ext2_ok="$ext2_ok"; display_ext2_warning="$ext2_warning"; display_ext2_critical="$ext2_critical"
        fi
    elif [ "$ext2_present" -eq 1 ]; then
        display_ext1_name="${ext2_name/EXT 2/EXT 1}"; display_ext1_temp="$ext2_temp_display"
        display_ext1_ok="$ext2_ok"; display_ext1_warning="$ext2_warning"; display_ext1_critical="$ext2_critical"
    fi

    tmp_file="$run_dir/lab.$$.tmp"
    {
        echo "lab_cpu_temp: $(value_from_sysinfo temperature_cpu)"
